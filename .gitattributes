# Normalise line endings: LF in the repository, native in the working copy.
# Stops the "LF will be replaced by CRLF" warnings on Windows.
* text=auto eol=lf
*.pt binary
*.npy binary
*.png binary

*.engine binary
*.onnx binary
# Preserve the exact archived build bytes, including original source whitespace.
deployment/h100_shared/** -text -whitespace
